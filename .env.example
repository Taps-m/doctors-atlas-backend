# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string from Neon.tech (or your provider of choice)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://doctors-atlas.vercel.app
